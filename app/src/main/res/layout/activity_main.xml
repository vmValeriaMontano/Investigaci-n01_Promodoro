<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">
    <!--
   fillViewport permite que si el usuario usa una pantalla pequeña
   o abre el teclado lo de adentro se le podra hacer scroll hacia abajo
   -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TEXTO DE ESTADO / TAREA ACTIVA -->
        <TextView
            android:id="@+id/tvTareaActiva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin tarea activa seleccionada"
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- CRONÓMETRO POMODORO -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="25:00"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- BOTONES DE CONTROL EN CUADRÍCULA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="INICIAR"
                    android:textColor="#e6f037"
                    android:textStyle="bold"
                    android:backgroundTint="#6164ed" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="REINICIAR"
                    android:textColor="#090ded"
                    android:textStyle="bold"
                    android:backgroundTint="#F5F5F5" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="PAUSAR"
                    android:textColor="#757575"
                    android:textStyle="bold"
                    android:backgroundTint="#F5F5F5" />

                <Button
                    android:id="@+id/btnResume"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="REANUDAR"
                    android:textColor="#757575"
                    android:textStyle="bold"
                    android:backgroundTint="#F5F5F5" />
                <!--
                weightSum="2" garantiza que los botones midan la mitad
                de la pantalla cada uno
                -->

                <!--
                layout_weight="1" haca que los botones hijos
                compartan la mitad del espacio del celular
                -->
            </LinearLayout>
        </LinearLayout>

        <!-- DIVISOR VISUAL SUTIL -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="24dp" />

        <!-- INPUT DE NUEVA TAREA -->
        <EditText
            android:id="@+id/etNuevaTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe una nueva tarea..."
            android:textSize="18sp"
            android:padding="12dp"
            android:background="@null"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:layout_marginBottom="8dp" />

        <!-- BOTÓN AGREGAR  -->
        <Button
            android:id="@+id/btnAgregarTarea"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:text="AGREGAR"
            android:textColor="#e6f037"
            android:textStyle="bold"
            android:backgroundTint="#090ded"
            android:layout_marginBottom="16dp" />

        <!-- RESUMEN DE PROGRESO -->
        <TextView
            android:id="@+id/tvResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 pendientes · 0 sesiones completadas"
            android:textColor="#757575"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- SECCIÓN DE TAREAS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tareas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Mensaje vacío de Tareas -->
        <TextView
            android:id="@+id/tvTareasVacias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay tareas todavía. ¡Agrega la primera!"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Contenedor dinámico para Tareas -->
        <LinearLayout
            android:id="@+id/contenedorTareas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- SECCIÓN DE HISTORIAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de sesiones"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Mensaje vacío de Historial -->
        <TextView
            android:id="@+id/tvHistorialVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no completaste ninguna sesión"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="16dp" />

        <!-- Contenedor dinámico para Historial -->
        <LinearLayout
            android:id="@+id/contenedorHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- contenedorTareas y  contenedorHistorial
        deja que se inserte tareas de forma ilimitada -->

    </LinearLayout>
</ScrollView>